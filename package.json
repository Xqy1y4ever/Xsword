{
  "name": "vocab-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "移动端优先的背单词应用：两种题型、每日计划、熟练度与词源记忆卡片",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/api.mjs --reload",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/api.mjs",
    "test": "node scripts/pytest.mjs",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/py.mjs -m app.cli.init_seed",
    "set-password": "node scripts/py.mjs -m app.cli.set_password",
    "annotate": "node scripts/py.mjs -m app.cli.annotate"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
