# 复制为 .env 后填写。生产环境务必替换 SESSION_SECRET 与 ADMIN_PASSWORD_HASH。
HOST=0.0.0.0
PORT=3000
DB_PATH=./data/app.db
TIMEZONE=Asia/Shanghai
SESSION_TTL_DAYS=30
COOKIE_SECURE=0

# 会话签名密钥：openssl rand -hex 32
SESSION_SECRET=

# 单用户口令哈希：由 `npm run set-password -- 你的口令` 生成
ADMIN_PASSWORD_HASH=

# 大模型配置已改为存数据库：登录后在「设置 → 词源标注模型」填写 Base URL / API Key / 模型名，
# 或调用 PUT /api/llm-config。下面的 LLM_* 仅用于把旧 .env 配置一次性导入数据库
# （首次启动且数据库里还没有配置行时生效），新部署请留空。
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BATCH_SIZE=20
