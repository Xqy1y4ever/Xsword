[Unit]
Description=Vocab app (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按实际部署路径修改
WorkingDirectory=/opt/vocab-app
EnvironmentFile=/opt/vocab-app/.env
Environment=PYTHONPATH=/opt/vocab-app/backend
Environment=PYTHONUNBUFFERED=1
# 使用 conda 环境的 python（与开发环境一致）：
ExecStart=/opt/conda/envs/xcclient/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 3000
# 若使用系统 python + venv，改为：
# ExecStart=/opt/vocab-app/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 3000
User=vocab
Group=vocab
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
